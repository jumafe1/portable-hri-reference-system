@@ -161,6 +162,11 @@ class YoloNode(LifecycleNode):
         """
         self.get_logger().info(f"[{self.get_name()}] Activating...")
 
+        # Set the backend before loading/warming the model. On unsupported CPUs,
+        # NNPACK otherwise retries initialization and writes native warnings for
+        # every inference; those warnings bypass the ROS logger's severity.
+        torch.backends.nnpack.set_flags(self.get_parameter("enable_nnpack").value)
+
         try:
             self.yolo = self.type_to_model[self.model_type](self.model)
             self.yolo.to(self.device)
